# Bien moi truong cho BE Spring Boot (copy thanh /opt/pa1-be/be.env roi sua mat khau).
# Ten bien khop voi src/main/resources/application.yaml cua nhom.
# BE LUON ket noi qua LISTENER (lsn-*) de van chay sau failover. Ten lsn-* co trong /etc/hosts may HN.
SERVER_PORT=8080

# Du lieu mau trong database/init cua nhom la nam 2025 -> chay profile prototype (ngay hien tai = 2025-06-02).
# Bo dong nay neu muon dung ngay that.
SPRING_PROFILES_ACTIVE=prototype

# Datasource mac dinh (Spring/Flyway). Flyway TAT: stored procedure da duoc 25-sp.sh cai san.
DB_URL=jdbc:sqlserver://lsn-hn:1433;databaseName=QLXeKhach_HN;encrypt=true;trustServerCertificate=true
DB_USERNAME=app_user
DB_PASSWORD=<mat-khau-app_user>
FLYWAY_ENABLED=false

# 3 chi nhanh (BranchRoutingConfig): /hn -> CN01, /dn -> CN02, /hcm -> CN03
DB_HN_URL=jdbc:sqlserver://lsn-hn:1433;databaseName=QLXeKhach_HN;encrypt=true;trustServerCertificate=true
DB_HN_USERNAME=app_user
DB_HN_PASSWORD=<mat-khau-app_user>
DB_DN_URL=jdbc:sqlserver://lsn-dn:1433;databaseName=QLXeKhach_DN;encrypt=true;trustServerCertificate=true
DB_DN_USERNAME=app_user
DB_DN_PASSWORD=<mat-khau-app_user>
DB_HCM_URL=jdbc:sqlserver://lsn-hcm:1433;databaseName=QLXeKhach_HCM;encrypt=true;trustServerCertificate=true
DB_HCM_USERNAME=app_user
DB_HCM_PASSWORD=<mat-khau-app_user>

# Gioi han RAM cho JVM (may HN con chay 2 SQL Server)
JAVA_OPTS=-Xms256m -Xmx768m
