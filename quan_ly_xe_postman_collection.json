      ]
    },
    {
      "name": "03. Sprint 1 - UC-003 & UC-004 Tuyến đường & Giá vé (MH01 Tab 2)",
      "item": [
        {
          "name": "1. Lấy danh sách tuyến đường kèm giá vé (sp_LayDanhSachTuyenVaGia)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{site}}/api/v1/cauhinh/tuyen-duong",
              "host": ["{{baseUrl}}"],
              "path": ["{{site}}", "api", "v1", "cauhinh", "tuyen-duong"]
            }
          }
        },
        {
          "name": "2. Lấy chi tiết 1 tuyến đường (T01)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{site}}/api/v1/cauhinh/tuyen-duong/T01",
              "host": ["{{baseUrl}}"],
              "path": ["{{site}}", "api", "v1", "cauhinh", "tuyen-duong", "T01"]
            }
          }
        },
        {
          "name": "3. Thêm tuyến kèm 4 mức giá vé (UC-003 - sp_ThemTuyenVaGia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diemDau\": \"Hà Nội\",\n  \"diemCuoi\": \"Sa Pa\",\n  \"doDaiKm\": 320,\n  \"capDo\": 3,\n  \"giaThuong\": 280000,\n  \"giaCuoiTuan\": 320000,\n  \"giaMuaDL\": 350000,\n  \"giaLeTet\": 400000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hn/api/v1/cauhinh/tuyen-duong",
              "host": ["{{baseUrl}}"],
              "path": ["hn", "api", "v1", "cauhinh", "tuyen-duong"]
            },
            "description": "Tự sinh mã tuyến tăng dần (T03, T04...) và lưu tuyến + 4 giá vé trong 1 transaction SQL Server."
          }
        },
        {
          "name": "4. Sửa giá vé 1 loại ngày (UC-004 - sp_UpsertBangGiaVe)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maLoaiNgay\": \"CUOITUAN\",\n  \"giaVe\": 450000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hn/api/v1/cauhinh/tuyen-duong/T01/gia-ve",
              "host": ["{{baseUrl}}"],
              "path": ["hn", "api", "v1", "cauhinh", "tuyen-duong", "T01", "gia-ve"]
            }
          }
        },
        {
          "name": "5. Cập nhật bảng giá vé hàng loạt (UC-004 - MH01 Tab 2)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"maTuyen\": \"T01\",\n    \"maLoaiNgay\": \"LETET\",\n    \"giaVe\": 500000\n  },\n  {\n    \"maTuyen\": \"T02\",\n    \"maLoaiNgay\": \"CUOITUAN\",\n    \"giaVe\": 270000\n  },\n  {\n    \"maTuyen\": \"T02\",\n    \"maLoaiNgay\": \"LETET\",\n    \"giaVe\": 320000\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/hn/api/v1/cauhinh/tuyen-duong/gia-ve/hang-loat",
              "host": ["{{baseUrl}}"],
              "path": ["hn", "api", "v1", "cauhinh", "tuyen-duong", "gia-ve", "hang-loat"]
            }
          }
        },
        {
