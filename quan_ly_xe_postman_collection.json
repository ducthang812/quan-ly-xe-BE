{
  "info": {
    "_postman_id": "a98c5df1-c852-4a0b-9df0-7d6f51f49618",
    "name": "Quản Lý Xe Khách - Module A (Người A) - Sprint 0 & 1",
    "description": "Bộ Postman Collection kiểm thử toàn bộ API Backend của Người A (Cấu hình, Tuyến đường, Giá vé, Tài xế, Danh mục).\n- 100% sử dụng Stored Procedures T-SQL trong SQL Server.\n- Định tuyến phân tán theo định dạng URL Dạng A: /{site}/api/v1/... (site = hn, dn, hcm).\n- Quyền ghi/cập nhật chỉ dành cho /hn. Các chi nhánh khác (/dn, /hcm) chỉ đọc dữ liệu qua Linked Server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "site",
      "value": "hn",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Kiểm tra tiền tố URL & Phân quyền ghi/đọc",
      "item": [
        {
          "name": "1. Lỗi thiếu tiền tố chi nhánh (Mong đợi 400 Bad Request)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cauhinh/tham-so",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cauhinh", "tham-so"]
            },
            "description": "Gọi không có prefix /hn, /dn hoặc /hcm sẽ bị chặn ngay lập tức."
          }
        },
        {
          "name": "2. Lỗi dùng tiền tố Dạng B (Mong đợi 400 Bad Request)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hn/cauhinh/tham-so",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hn", "cauhinh", "tham-so"]
            },
            "description": "Chỉ chấp nhận Dạng A /{site}/api/v1/..."
          }
        },
        {
          "name": "3. Chặn cập nhật từ site Đà Nẵng (Mong đợi 403 Forbidden)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donGiaKm\": 3000,\n  \"hsLai\": 1.0,\n  \"hsPhu\": 0.6,\n  \"hsLuongCap1\": 1.0,\n  \"hsLuongCap2\": 1.2,\n  \"hsLuongCap3\": 1.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/dn/api/v1/cauhinh/tham-so/thu-lao",
              "host": ["{{baseUrl}}"],
              "path": ["dn", "api", "v1", "cauhinh", "tham-so", "thu-lao"]
            },
            "description": "Chi nhánh DN không có quyền cập nhật dữ liệu cấu hình dùng chung."
          }
        },
        {
          "name": "4. Cho phép đọc từ site Đà Nẵng (Mong đợi 200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dn/api/v1/cauhinh/tham-so",
              "host": ["{{baseUrl}}"],
              "path": ["dn", "api", "v1", "cauhinh", "tham-so"]
            },
            "description": "Site DN đọc dữ liệu dùng chung thông qua Stored Procedure trên DB DN gọi Linked Server SERVER_HN."
          }
        }
      ]
    },
    {
      "name": "01. Sprint 0 - Danh mục dùng chung & Mức độ sẵn sàng",
      "item": [
        {
          "name": "1. Lấy danh sách chi nhánh (sp_LayDanhSachChiNhanh)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{site}}/api/v1/cauhinh/danh-muc/chi-nhanh",
              "host": ["{{baseUrl}}"],
              "path": ["{{site}}", "api", "v1", "cauhinh", "danh-muc", "chi-nhanh"]
            }
          }
        },
        {
          "name": "2. Lấy lịch loại ngày (sp_LayDanhSachLichNgay)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{site}}/api/v1/cauhinh/danh-muc/lich-ngay?nam=2025",
              "host": ["{{baseUrl}}"],
              "path": ["{{site}}", "api", "v1", "cauhinh", "danh-muc", "lich-ngay"],
              "query": [
                {
                  "key": "nam",
                  "value": "2025"
                }
              ]
            }
          }
        },
        {
          "name": "3. Mức độ sẵn sàng hệ thống MH01.0 - UC-001 (sp_KiemTraMucDoSanSang)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{site}}/api/v1/cauhinh/danh-muc/muc-do-san-sang",
              "host": ["{{baseUrl}}"],
              "path": ["{{site}}", "api", "v1", "cauhinh", "danh-muc", "muc-do-san-sang"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Sprint 1 - UC-002 Thiết lập tham số (MH01 Tab 1)",
      "item": [
        {
          "name": "1. Lấy toàn bộ tham số & độ phức tạp (MH01 Tab 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{site}}/api/v1/cauhinh/tham-so",
              "host": ["{{baseUrl}}"],
              "path": ["{{site}}", "api", "v1", "cauhinh", "tham-so"]
            }
          }
        },
        {
          "name": "2. Cập nhật tham số thù lao (sp_CapNhatThamSoThuLao)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donGiaKm\": 2000,\n  \"hsLai\": 1.0,\n  \"hsPhu\": 0.6,\n  \"hsLuongCap1\": 1.0,\n  \"hsLuongCap2\": 1.2,\n  \"hsLuongCap3\": 1.5\n}"
