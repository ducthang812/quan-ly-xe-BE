            "body": {
              "mode": "raw",
              "raw": "{\n  \"chuKyBd\": 360,\n  \"kmMoiNgayBd\": 100,\n  \"canhBaoNgay\": 15,\n  \"chuKyDkCu\": 6,\n  \"chuKyDkMoi\": 12,\n  \"tuoiXeCu\": 5,\n  \"hsDuongKhoCap1\": 1.0,\n  \"hsDuongKhoCap2\": 1.3,\n  \"hsDuongKhoCap3\": 1.6\n}"
